APP_NAME="Internal Doc Assistant"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ──────────────────────────────────────────────────────────────────
# Database — PostgreSQL (required for pgvector extension)
# Use the bundled docker-compose.yml for a one-command local setup:
#   docker compose up -d
# ──────────────────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=doc_assistant
DB_USERNAME=postgres
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Used by laravel/ai embedding cache (see config/ai.php)
CACHE_STORE=database

VITE_APP_NAME="${APP_NAME}"

# ──────────────────────────────────────────────────────────────────
# AI Providers
# ──────────────────────────────────────────────────────────────────

# Anthropic — used for text generation (primary)
# Get key: https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Override for proxy routing (e.g. LiteLLM, Helicone)
ANTHROPIC_URL=https://api.anthropic.com/v1

# OpenAI — used for embeddings (text-embedding-3-small, 1536 dims)
# and as failover text provider + Vector Stores path
# Get key: https://platform.openai.com/
OPENAI_API_KEY=
# Override for proxy routing
OPENAI_URL=https://api.openai.com/v1
OPENAI_STORE=true

# Cohere — used for reranking (rerank-english-v3.0)
# Get key: https://dashboard.cohere.com/
COHERE_API_KEY=

# ──────────────────────────────────────────────────────────────────
# Other providers (optional — not used by this app by default)
# ──────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_URL=https://generativelanguage.googleapis.com/v1beta/
GROQ_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
ELEVENLABS_API_KEY=
JINA_API_KEY=
VOYAGEAI_API_KEY=
OLLAMA_URL=http://localhost:11434
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_URL=
